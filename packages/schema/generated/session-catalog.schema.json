{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalogVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "enum": [
        "discover",
        "import"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "jsonl",
        "otlp",
        "codex",
        "claude",
        "opencode",
        "omp",
        "grok"
      ]
    },
    "dryRun": {
      "type": "boolean",
      "const": true
    },
    "matchedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selectedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "jsonl",
              "otlp",
              "codex",
              "claude",
              "opencode",
              "omp",
              "grok"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "projectHint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "firstPromptPreview": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "lastPromptPreview": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eventCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "warningCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "source",
          "title",
          "projectHint",
          "firstPromptPreview",
          "lastPromptPreview",
          "lastActivityAt",
          "byteLength",
          "eventCount",
          "warningCount",
          "modifiedAt"
        ],
        "additionalProperties": false
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "code": {
            "type": "string",
            "enum": [
              "preflight_failed",
              "unsupported_version",
              "no_visible_events",
              "stale_session",
              "file_too_large",
              "unknown_source_format"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "skippedByLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unreadableDirectories": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejectedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "missingSessionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{24}$"
      }
    }
  },
  "required": [
    "catalogVersion",
    "command",
    "source",
    "matchedFiles",
    "selectedFiles",
    "sessions",
    "failed",
    "skippedByLimit",
    "unreadableDirectories",
    "rejectedFiles",
    "missingSessionIds"
  ],
  "additionalProperties": false
}
