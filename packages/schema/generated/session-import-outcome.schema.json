{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "level": {
      "type": "string",
      "const": "result"
    },
    "command": {
      "type": "string",
      "enum": [
        "import",
        "follow",
        "upload"
      ]
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "traceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "inserted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warnings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "protocolVersion",
    "level",
    "command",
    "sessionId",
    "traceId",
    "inserted",
    "duplicates",
    "warnings"
  ],
  "additionalProperties": false
}
