{
  "name": "@intenttrace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "schema:check": "drizzle-kit check",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@intenttrace/config": "workspace:*",
    "@intenttrace/ingest": "workspace:*",
    "@intenttrace/intent-reducer": "workspace:*",
    "@intenttrace/schema": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
