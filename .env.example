## Docker Compose only: blank means an automatically allocated loopback port.
INTENTTRACE_WEB_PORT=

## Host-run development defaults. Compose replaces these with container DNS names.
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.0.0
GIT_COMMIT=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgres://intenttrace:intenttrace@127.0.0.1:15432/intenttrace
ARTIFACT_ROOT=.intenttrace/artifacts
PROVIDER_MODE=mock
PROVIDER_EGRESS_ENABLED=false
PROVIDER_DAILY_BUDGET_USD=0
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_EVENTS=256
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
INTENTTRACE_API_ORIGIN=http://127.0.0.1:3001
